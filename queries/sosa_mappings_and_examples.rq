PREFIX odim:    <http://connectdigitalstudy.com/ontology#>
PREFIX sosa:    <http://www.w3.org/ns/sosa/>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:     <http://www.w3.org/2002/07/owl#>

ASK {
  # Class mapping exists
  odim:Measurement rdfs:subClassOf sosa:Observation .

  # Property mappings exist (via subPropertyOf on convenience props)
  odim:observedProperty rdfs:subPropertyOf sosa:observedProperty .
  odim:featureOfInterest rdfs:subPropertyOf sosa:hasFeatureOfInterest .

  # Canonical observable properties are ontology members, and specialised
  # observation classes state which property their instances observe.
  odim:HeartRate a sosa:ObservableProperty .
  odim:HeartRateMeasurement rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty odim:observedProperty ;
    owl:hasValue odim:HeartRate
  ] .
  odim:RespiratoryRate a sosa:ObservableProperty .
  odim:SleepStage a sosa:ObservableProperty .
  odim:HeartRateVariabilitySdnn a sosa:ObservableProperty .
  odim:HeartRateVariabilityRmssd a sosa:ObservableProperty .
  odim:StepCount a sosa:ObservableProperty .
  odim:Distance a sosa:ObservableProperty .
  odim:EnergyExpenditure a sosa:ObservableProperty .
  odim:ExerciseDuration a sosa:ObservableProperty .
  odim:FlightsClimbed a sosa:ObservableProperty .
  VALUES (?measurementClass ?observableProperty) {
    (odim:RespiratoryRateMeasurement odim:RespiratoryRate)
    (odim:SleepStageMeasurement odim:SleepStage)
    (odim:HeartRateVariabilitySdnnMeasurement odim:HeartRateVariabilitySdnn)
    (odim:HeartRateVariabilityRmssdMeasurement odim:HeartRateVariabilityRmssd)
    (odim:StepCountMeasurement odim:StepCount)
    (odim:DistanceMeasurement odim:Distance)
    (odim:EnergyExpenditureMeasurement odim:EnergyExpenditure)
    (odim:ExerciseDurationMeasurement odim:ExerciseDuration)
    (odim:FlightsClimbedMeasurement odim:FlightsClimbed)
  }
  ?measurementClass rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty odim:observedProperty ;
    owl:hasValue ?observableProperty
  ] .

  # Examples have observedProperty and FOI
  odim:HeartRateMeasurementX odim:observedProperty odim:HeartRate ;
                             odim:featureOfInterest odim:ParticipantX .
  odim:HeartRateVariabilityMeasurementX odim:observedProperty odim:HeartRateVariability ;
                                        odim:featureOfInterest odim:ParticipantX .
  odim:ActivityMeasurementX odim:observedProperty odim:ActivityDuration ;
                            odim:featureOfInterest odim:ParticipantX .
  odim:SleepStageMeasurementX odim:observedProperty odim:SleepStage ;
                              odim:featureOfInterest odim:ParticipantX .
}
